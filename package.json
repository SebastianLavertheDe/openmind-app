{
  "name": "openmind-desktop",
  "version": "1.0.24",
  "description": "A cross-platform desktop control center for openmind.",
  "author": "OpenMind",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": ".build/electron/electron/main.js",
  "scripts": {
    "clean": "node scripts/clean-build.js",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/build-preload.js",
    "prepare:python-runtime": "node scripts/prepare-bundled-python-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "lint:reporoot": "node scripts/audit-no-reporoot.js",
    "lint:manifests": "tsx scripts/validate-all-skill-manifests.mjs",
    "build": "npm run clean && npm run typecheck && npm run lint:reporoot && npm run lint:manifests && npm run build:renderer && npm run build:electron",
    "start": "npm run build && npm run prepare:python-runtime -- --if-missing && electron .",
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "node scripts/dev-electron.mjs",
    "verify": "npm run build && npm run test:unit && npm run test:integration && npm run test:e2e && node scripts/verify.js && npm run release:evidence && npm run recovery:drill && npm run lint:reporoot && npm run perf:check && npm run perf:stream && npm run audit:evidence && npm run scale:check && npm run runtime:contract && npm run stability:soak && npm run visual:snapshot && npm run provider:e2e:report && npm run provider:e2e:contract && npm run security:review && npm run clean-machine:report && npm run evidence:contract && npm run package:safety && npm run package:safety:contract && npm run package:artifact:contract && npm run release:readiness && npm run release:readiness:contract && npm run motion:check && npm run typography:check && npm run color:check",
    "perf:check": "node scripts/perf-check.js",
    "perf:resize": "node scripts/resize-performance.js",
    "perf:documents": "node scripts/document-performance.js",
    "perf:ai-context": "node scripts/ai-context-performance.js",
    "perf:services": "node scripts/service-performance.js",
    "perf:stream": "node scripts/stream-performance.js",
    "perf:motion": "node scripts/motion-performance.js",
    "audit:evidence": "node scripts/audit-evidence.js",
    "audit:responsive-hardcode": "node scripts/audit-responsive-hardcode.js",
    "audit:ui-copy-hardcode": "node scripts/audit-ui-copy-hardcode.js",
    "scale:check": "node scripts/scale-check.js",
    "runtime:contract": "vitest run electron/runtime/runtime-manager.test.ts",
    "stability:soak": "node scripts/stability-soak.js",
    "visual:snapshot": "node scripts/visual-snapshot.js",
    "visual:settings": "electron scripts/settings-design-qa-electron.js",
    "provider:e2e:report": "node scripts/provider-e2e-report.js",
    "provider:e2e:contract": "node scripts/provider-e2e-contract.js",
    "security:review": "node scripts/security-review-report.js",
    "clean-machine:report": "node scripts/clean-machine-report.js",
    "evidence:contract": "node scripts/evidence-gate-contract.js",
    "release:evidence": "node scripts/generate-release-evidence.js",
    "release:readiness": "node scripts/release-readiness-report.js",
    "release:readiness:contract": "node scripts/release-readiness-contract.js",
    "recovery:drill": "node scripts/recovery-drill.js && node scripts/process-crash-recovery-drill.js",
    "package:recovery:smoke": "node scripts/packaged-recovery-smoke.js",
    "package:safety": "node scripts/package-safety-scan.js",
    "package:safety:contract": "node scripts/package-safety-contract.js",
    "package:artifact:safety": "node scripts/package-artifact-safety.js",
    "package:artifact:contract": "node scripts/package-artifact-report-contract.js",
    "motion:check": "node scripts/motion-contract-check.js",
    "typography:check": "node scripts/typography-contract-check.js",
    "color:check": "node scripts/color-contrast-contract-check.js",
    "test": "npm run build && npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run",
    "test:integration": "node scripts/integration-smoke.js",
    "test:e2e": "node scripts/electron-e2e.js",
    "cli:install:smoke": "node scripts/cli-install-smoke.js",
    "test:coverage": "vitest run --coverage",
    "dist": "npm run build && npm run prepare:python-runtime && electron-builder",
    "dist:win": "npm run build && npm run prepare:python-runtime -- --target=windows-x64 && electron-builder --win",
    "dist:win:staged": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "dist:mac": "npm run build && npm run prepare:python-runtime && electron-builder --mac",
    "dist:mac:staged": "bash scripts/package-macos.sh"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^8.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-istanbul": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^42.8.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tsx": "^4.23.8",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.openmind.desktop",
    "productName": "OpenMind",
    "icon": "build/icon.svg",
    "afterPack": "scripts/finalize-bundled-python-runtime.cjs",
    "afterSign": "scripts/finalize-bundled-python-runtime.cjs",
    "files": [
      ".build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/python-runtime",
        "to": "python-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "portable",
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "OpenMind-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "OpenMind-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.175",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "@playwright/mcp": "0.0.78",
    "@tanstack/react-virtual": "^3.14.11",
    "diff": "^9.0.0",
    "fast-xml-parser": "^5.9.0",
    "fflate": "^0.8.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "js-yaml": "^5.2.3",
    "jsdom": "^24.1.3",
    "katex": "^0.17.0",
    "lucide-react": "^1.18.0",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3"
  }
}
