{
  "name": "cctools-desktop",
  "version": "1.0.24",
  "description": "A cross-platform desktop control center for cctools.",
  "author": "CC Tools",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": ".build/electron/electron/main.js",
  "scripts": {
    "clean": "node scripts/clean-build.js",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/build-preload.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run clean && npm run typecheck && npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "dev": "vite --host 127.0.0.1",
    "verify": "npm run build && node scripts/verify.js && npm run perf:check && npm run audit:evidence && npm run scale:check && npm run visual:snapshot && npm run provider:e2e:report && npm run package:safety && npm run motion:check",
    "perf:check": "node scripts/perf-check.js",
    "audit:evidence": "node scripts/audit-evidence.js",
    "scale:check": "node scripts/scale-check.js",
    "visual:snapshot": "node scripts/visual-snapshot.js",
    "provider:e2e:report": "node scripts/provider-e2e-report.js",
    "package:safety": "node scripts/package-safety-scan.js",
    "motion:check": "node scripts/motion-contract-check.js",
    "test": "npm run build && vitest run && node scripts/integration-smoke.js",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:staged": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^8.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-istanbul": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.21.5",
    "jsdom": "^24.1.3",
    "typescript": "^6.0.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.cctools.desktop",
    "productName": "CC Tools",
    "icon": "build/icon.svg",
    "files": [
      ".build/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "portable",
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "CC-Tools-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "CC-Tools-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.175",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/mcp": "0.0.78",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "diff": "^9.0.0",
    "fast-xml-parser": "^5.9.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.18.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.4.3"
  }
}
